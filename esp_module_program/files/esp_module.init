#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    logger "esp_module: starting..."

    procd_open_instance

    procd_set_param command /usr/bin/esp_module

    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}


reload_service() {
    procd_send_signal esp_module
}

